(function(){
const KEY="retro_revivals_screenshot_v5";

const get=()=>{
  try{
    return JSON.parse(localStorage.getItem(KEY)||"{}");
  }catch(e){
    return {};
  }
};

const put=o=>{
  localStorage.setItem(KEY,JSON.stringify(o));
};

function refresh(){

  const o=get();

  const boxes=[
    ...document.querySelectorAll(".card input")
  ];

  const total=
    Number(window.PAGE_TOTAL) || boxes.length;

  boxes.forEach(b=>{
    b.checked=!!o[b.dataset.id];

    const card=b.closest(".card");

    if(card){
      card.classList.toggle(
        "owned",
        b.checked
      );
    }
  });

  const n=
    boxes.filter(b=>b.checked).length;

  const p=
    total
      ? Math.round((n/total)*100)
      : 0;

  document
    .querySelectorAll("[data-owned]")
    .forEach(x=>{
      x.textContent=n;
    });

  document
    .querySelectorAll("[data-total]")
    .forEach(x=>{
      x.textContent=total;
    });

  document
    .querySelectorAll("[data-percent]")
    .forEach(x=>{
      x.textContent=p+"%";
    });
}

function filter(){

  const search=
    document.querySelector("#search");

  const status=
    document.querySelector("#status");

  const q=
    (search?.value||"")
      .toLowerCase()
      .trim();

  const selected=
    status?.value || "All";

  document
    .querySelectorAll(".card")
    .forEach(card=>{

      const box=
        card.querySelector("input");

      const text=
        card.textContent
          .toLowerCase();

      const matchesSearch=
        !q ||
        text.includes(q);

      const matchesStatus=
        selected==="All" ||

        (
          selected==="Owned" &&
          box?.checked
        ) ||

        (
          selected==="Missing" &&
          box &&
          !box.checked
        );

      card.style.display=
        matchesSearch &&
        matchesStatus
          ? ""
          : "none";
    });
}

document.addEventListener(
  "DOMContentLoaded",
  ()=>{

    document
      .querySelectorAll(".card input")
      .forEach(box=>{

        box.addEventListener(
          "change",
          ()=>{

            const o=get();

            o[box.dataset.id]=
              box.checked;

            put(o);

            refresh();
            filter();
          }
        );
      });

    const search=
      document.querySelector("#search");

    if(search){
      search.addEventListener(
        "input",
        filter
      );
    }

    const status=
      document.querySelector("#status");

    if(status){
      status.addEventListener(
        "change",
        filter
      );
    }

    refresh();
    filter();
  }
);

window.resetCollection=()=>{

  if(
    confirm(
      "Reset your Retro Revivals collection?"
    )
  ){

    localStorage.removeItem(KEY);

    location.reload();
  }
};

window.exportCollection=()=>{

  const o=get();

  const rows=[
    ["ID","Owned"],

    ...Object.entries(o)
      .map(([id,value])=>[
        id,
        value ? "Yes" : "No"
      ])
  ];

  const csv=
    rows
      .map(row=>
        row
          .map(value=>
            `"${String(value)
              .replaceAll('"','""')}"`
          )
          .join(",")
      )
      .join("\n");

  const blob=
    new Blob(
      ["\ufeff"+csv],
      {
        type:"text/csv;charset=utf-8"
      }
    );

  const url=
    URL.createObjectURL(blob);

  const link=
    document.createElement("a");

  link.href=url;

  link.download=
    "retro-revivals-collection.csv";

  document.body.appendChild(link);

  link.click();

  document.body.removeChild(link);

  setTimeout(()=>{
    URL.revokeObjectURL(url);
  },1000);
};

})();
